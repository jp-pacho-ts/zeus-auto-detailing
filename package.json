{
  "name": "zeus-auto-detailing-booking-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint src tailwind.config.ts next.config.mjs postcss.config.mjs --config src/lib/eslint.config.mjs --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --require ./src/server/__tests__/register.cjs --test \"src/**/*.test.ts\"",
    "staff:credential": "tsx --require ./src/server/auth/cli-preload.cjs src/server/auth/staff-credential.ts",
    "docs:docx": "node scripts/generate-proposal-docx.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@gsap/react": "2.1.2",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.50.0",
    "motion": "^14.10.1",
    "next": "16.3.8",
    "nodemailer": "10.1.6",
    "prisma": "6.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "split-type": "0.3.4",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "docx": "^9.11.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.29",
    "prisma": "6.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
