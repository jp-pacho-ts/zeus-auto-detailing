# PostgreSQL connection URL. Replace all placeholders locally; never commit .env files.
# DATABASE_URL must use a pool that preserves connection affinity during transactions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zeus?schema=public"

# T-002 does not connect to a database. TEAM-DATA owns Prisma setup in T-003.
# Public shop timezone and currency defaults are configured in src/config/brand.ts.
# Staff authentication environment variables belong to the later auth implementation.

# --- Staff authentication (P1-06, ADR-003) ---
# Exact origin staff pages are served from; unsafe /api/admin requests must send this Origin.
APP_ORIGIN="http://localhost:3000"
# In production DATABASE_URL must also set connection_limit=32 (or more) and pool_timeout=2,
# or the server refuses to start (27 customer + 5 staff connections).
# Client identity for sign-in limits. Required in production, where it must be PROXY_HOPS:
# the rightmost TRUSTED_PROXY_HOPS (1-3) X-Forwarded-For entries come from trusted proxies.
# Set it only after the ingress topology is verified (P1-10). Outside production the default,
# LOCAL_DEVELOPMENT, ignores forwarding headers and puts every client in one shared bucket.
# CLIENT_IP_SOURCE="PROXY_HOPS"
# TRUSTED_PROXY_HOPS="1"
# One-off bootstrap for `npm run staff:credential -- set-password ...` where no terminal is
# available. Set it only for that command and unset it right after. Never commit a value.
# STAFF_BOOTSTRAP_PASSWORD=

# --- Customer day booking (P1-03; ADR-002 / ADR-005) ---
# Required in every environment, including development. No generated/fallback signing keys.
# Each ring: comma-separated kid:secret entries (1-3); distinct random 32-64 byte unpadded
# base64url secrets, never reused across rings or ORIGIN_AUTH_SECRET. Active kid must be listed.
# Generate each secret separately: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BOOKING_QUOTE_KEYS="REPLACE_WITH_KID_AND_RANDOM_SECRET"
BOOKING_QUOTE_ACTIVE_KID="quote-2026-10"
MANAGEMENT_GRANT_KEYS="REPLACE_WITH_KID_AND_DIFFERENT_RANDOM_SECRET"
MANAGEMENT_GRANT_ACTIVE_KID="grant-2026-10"
MANAGEMENT_SESSION_KEYS="REPLACE_WITH_KID_AND_ANOTHER_RANDOM_SECRET"
MANAGEMENT_SESSION_ACTIVE_KID="session-2026-10"
# Rotate by adding a verify key, changing active kid, then retiring only after max lifetime+1h:
# quote 15m; management grant 30d; session 24h. Grant-key retirement also ends derived sessions.
# APP_ORIGIN above also protects customer writes. Production requires an exact HTTPS origin.
# Customer mutations require exact Origin, application/json and x-zeus-booking: 1.
ONLINE_BOOKING_MODE="PAUSED"
TURNSTILE_SECRET_KEY="REPLACE_WITH_TURNSTILE_SECRET"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="REPLACE_WITH_PUBLIC_TURNSTILE_SITE_KEY"
TURNSTILE_ALLOWED_HOSTNAMES="localhost"
# Configure Cloudflare test keys explicitly only for local/testing; production refuses them.
# The widget uses action booking_create. No widget token is ever stored in a URL or log.
# P1-06 trusted identity settings above are reused; P1-10 verifies the proxy topology.
# One application process only until admission is shared (P1-10 deployment invariant).

# Optional booking email: dedicated shop Gmail + Google App Password (2-Step Verification).
# Missing/invalid configuration warns; bookings commit and the unique outbox stays pending.
# SMTP_HOST must be smtp.gmail.com. Port 465 uses implicit TLS; 587 requires STARTTLS.
# Certificates are always verified, TLS >=1.2; never use the owner's personal Gmail.
# Placeholders only. App Passwords live only in the local/deployment environment.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_APP_PASSWORD=""
SMTP_FROM=""
SMTP_SHOP_NOTIFY_EMAIL=""
# Maximum 3 attempts, 30s lease/backoff. Stable outbox-derived Message-ID aids recognition,
# but SMTP provides no idempotency guarantee: acceptance followed by finalize failure may
# resend after the lease. Before P1-14, confirm the Railway plan allows outgoing SMTP.