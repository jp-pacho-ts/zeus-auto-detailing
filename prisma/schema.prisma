datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum ServiceKind {
  CERAMIC_COATING
  PAINT_CORRECTION
  INTERIOR_DETAILING
  EXTERIOR_WASH_SEAL
  WINDOW_TINT_PPF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StaffRole {
  ADMIN
  MANAGER
  DETAILER
}

enum InventoryTransactionType {
  CONSUMPTION
  RESTOCK
  ADJUSTMENT
}

// -----------------------------------------------------------------------------
// Core Booking & Capacity Models
// -----------------------------------------------------------------------------

model VehicleCategory {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  description    String?
  sizeMultiplier Decimal?           @db.Decimal(5, 2)
  sortOrder      Int
  createdAt      DateTime           @default(now())
  offers         ServiceSizeOffer[]
  bookings       Booking[]

  @@map("vehicle_categories")
}

model Service {
  id                  String                  @id @default(uuid())
  name                String
  slug                String                  @unique
  description         String?
  category            ServiceKind
  durationMinutes     Int?
  price               Decimal?                @db.Decimal(10, 2)
  bayCapacityRequired Int                     @default(1)
  isActive            Boolean                 @default(true)
  bookings            Booking[]
  catalogVersions     CatalogServiceVersion[]
  recipes             ServiceRecipe[]

  @@map("services")
}

model TimeSlot {
  id                 String                 @id @default(uuid())
  dayOfWeek          Int
  startTime          String
  endTime            String
  maxVehicleCapacity Int                    @default(2)
  isActive           Boolean                @default(true)
  overrides          SlotCapacityOverride[]

  @@unique([dayOfWeek, startTime])
  @@map("time_slots")
}

model ScheduleConfig {
  id                         String   @id @default(uuid())
  defaultSlotIntervalMinutes Int      @default(30)
  defaultBayCapacity         Int      @default(2)
  openTime                   String   @default("08:00")
  closeTime                  String   @default("17:00")
  effectiveDate              DateTime @unique @db.Date

  @@map("schedule_configs")
}

model SlotCapacityOverride {
  id                 String   @id @default(uuid())
  date               DateTime @db.Date
  timeSlotId         String
  timeSlot           TimeSlot @relation(fields: [timeSlotId], references: [id])
  maxVehicleCapacity Int
  version            Int      @default(1)

  @@unique([date, timeSlotId])
  @@index([timeSlotId])
  @@map("slot_capacity_overrides")
}

model BlockedDate {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  reason    String
  isFullDay Boolean  @default(true)
  startTime String?
  endTime   String?

  @@index([date])
  @@map("blocked_dates")
}

model Booking {
  id                          String                     @id @default(uuid())
  referenceCode               String                     @unique
  customerName                String
  customerPhone               String
  customerEmail               String?
  vehiclePlate                String?
  vehicleModel                String
  vehicleCategoryId           String
  vehicleCategory             VehicleCategory            @relation(fields: [vehicleCategoryId], references: [id])
  serviceId                   String
  service                     Service                    @relation(fields: [serviceId], references: [id])
  bookingDate                 DateTime                   @db.Date
  startTime                   String? // legacy and catalog-v2 only (D1); NULL for QUEUE_V3
  endTime                     String?
  status                      BookingStatus              @default(PENDING)
  notes                       String?
  startsAt                    DateTime
  endsAt                      DateTime
  durationMinutes             Int?
  priceSnapshot               Decimal                    @db.Decimal(10, 2)
  serviceNameSnapshot         String
  vehicleCategoryNameSnapshot String
  idempotencyKey              String                     @unique
  requestHash                 String
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  snapshotVersion             SnapshotVersion            @default(LEGACY_V1)
  catalogReleaseId            String?
  catalogRelease              CatalogRelease?            @relation(fields: [catalogReleaseId], references: [id], onDelete: Restrict)
  vehicleSizeCodeSnapshot     String?
  catalogFingerprint          String?
  pricingAlgorithm            String?
  // ADR-005 day queue (QUEUE_V3 only; NULL on legacy rows). startsAt/endsAt hold the Manila day window.
  queueCode                   String?
  queue                       BookingQueue?              @relation(fields: [queueCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  queuePosition               Int?
  revision                    Int                        @default(1)
  managementTokenVersion      Int                        @default(1)
  operations                  BookingOperation[]
  managementGrants            BookingManagementGrant[]
  managementSessions          BookingManagementSession[]
  notificationOutbox          BookingNotificationOutbox?
  receiptTotalCentavos        Int? // immutable create receipt: the accepted quote's totals
  receiptEstimatedCentavos    Int?
  terminalAt                  DateTime?                  @db.Timestamptz(3)
  cancellationKind            BookingCancellationKind?
  createdTxId                 BigInt                     @default(dbgenerated("txid_current()"))
  lineItems                   BookingLineItem[]
  assignments                 BookingAssignment[]
  commissionPayouts           CommissionPayout[]
  inventoryTransactions       InventoryTransaction[]
  occupancy                   BayOccupancy?
  workerAssignments           BookingWorkerAssignment[]
  bayAssignments              BookingBayAssignment[]
  depositStatus               DepositStatus              @default(NONE)
  depositProofs               BookingDepositProof[]

  @@unique([bookingDate, queueCode, queuePosition])
  @@index([bookingDate, status, startTime, endTime])
  @@index([customerPhone, bookingDate(sort: Desc)])
  @@index([bookingDate, queueCode, status])
  @@index([serviceId])
  @@index([vehicleCategoryId])
  @@map("bookings")
}

// -----------------------------------------------------------------------------
// Detailer Staff & Commission Models
// -----------------------------------------------------------------------------

model Staff {
  id                    String                    @id @default(uuid())
  name                  String
  phone                 String
  email                 String                    @unique
  role                  StaffRole
  defaultCommissionRate Decimal                   @default(0.10) @db.Decimal(5, 2)
  isActive              Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  catalogPublishers     CatalogPublisher[]
  catalogEvents         CatalogPublicationEvent[]
  assignments           BookingAssignment[]
  commissionPayouts     CommissionPayout[]
  credential            StaffCredential?
  sessions              StaffSession[]
  queuesUpdated         BookingQueue[]            @relation("QueueUpdatedBy")
  capOverridesUpdated   QueueCapOverride[]        @relation("CapOverrideUpdatedBy")
  occupancies           BayOccupancy[]            @relation("OccupancyAssignedBy")
  workerAssignments     BookingWorkerAssignment[] @relation("AssignedWorker")
  workersAssigned       BookingWorkerAssignment[] @relation("WorkerAssignedBy")
  workerAuditTargets    BookingAuditEvent[]       @relation("WorkerAuditTarget")
  bayAssignments        BookingBayAssignment[]    @relation("BayAssignedBy")
  linesAdded            BookingLineItem[]         @relation("LineAddedBy")
  linesRemoved          BookingLineItem[]         @relation("LineRemovedBy")
  linePricesSet         BookingLineItem[]         @relation("LinePriceSetBy")
  auditEvents           BookingAuditEvent[]

  @@map("staff")
}

// ADR-003 Option A. The credential row is the per-staff lock for every auth writer.
model StaffCredential {
  staffId           String    @id
  staff             Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  passwordHash      String // argon2id PHC string
  generation        Int       @default(1) // S-01: +1 on every set/reset, never on rehash
  passwordChangedAt DateTime  @db.Timestamptz(3)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @db.Timestamptz(3)

  @@map("staff_credentials")
}

// Only the SHA-256 of the opaque cookie token is stored. No IP address or user agent.
model StaffSession {
  id                   String    @id @default(uuid())
  tokenHash            String    @unique
  staffId              String
  staff                Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  credentialGeneration Int
  createdAt            DateTime  @db.Timestamptz(3)
  lastSeenAt           DateTime  @db.Timestamptz(3)
  idleExpiresAt        DateTime  @db.Timestamptz(3)
  expiresAt            DateTime  @db.Timestamptz(3)
  revokedAt            DateTime? @db.Timestamptz(3)
  revokedReason        String? // LOGOUT, PASSWORD_CHANGED, DEACTIVATED, ADMIN_REVOKED or ROTATED

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_sessions")
}

model BookingAssignment {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  roleInJob  String   @default("Primary Detailer")
  assignedAt DateTime @default(now())

  @@index([bookingId])
  @@index([staffId])
  @@map("booking_assignments")
}

model CommissionPayout {
  id           String    @id @default(uuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id])
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id])
  earnedAmount Decimal   @db.Decimal(10, 2)
  isPaid       Boolean   @default(false)
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([bookingId])
  @@index([staffId])
  @@map("commission_payouts")
}

// -----------------------------------------------------------------------------
// Inventory & Bill of Materials (BOM) Models
// -----------------------------------------------------------------------------

model InventoryItem {
  id           String                 @id @default(uuid())
  name         String
  sku          String                 @unique
  category     String
  unit         String
  currentStock Decimal                @db.Decimal(10, 2)
  reorderLevel Decimal                @db.Decimal(10, 2)
  costPerUnit  Decimal                @db.Decimal(10, 2)
  createdAt    DateTime               @default(now())
  recipes      ServiceRecipe[]
  transactions InventoryTransaction[]

  @@map("inventory_items")
}

model ServiceRecipe {
  id               String        @id @default(uuid())
  serviceId        String
  service          Service       @relation(fields: [serviceId], references: [id])
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityRequired Decimal       @db.Decimal(8, 2)

  @@unique([serviceId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("service_recipes")
}

model InventoryTransaction {
  id              String                   @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem            @relation(fields: [inventoryItemId], references: [id])
  bookingId       String?
  booking         Booking?                 @relation(fields: [bookingId], references: [id])
  type            InventoryTransactionType
  quantity        Decimal                  @db.Decimal(8, 2)
  notes           String?
  createdAt       DateTime                 @default(now())

  @@index([inventoryItemId])
  @@index([bookingId])
  @@map("inventory_transactions")
}

// ADR-004: new releases use exact offers; legacy identity fields above are historical only.
enum CatalogReleaseState {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CatalogServiceGroup {
  WASH
  DETAILING
  GRAPHENE
  TINT
  PPF
  REPAINT
}

enum CatalogServiceType {
  BASE
  ADD_ON
}

enum PriceUnit {
  VEHICLE
  PANEL
}

enum OfferState {
  OFFERED
  NOT_OFFERED
  UNCONFIRMED
}

enum CatalogBookingMode {
  FIXED_ONLINE
  QUOTE_REQUIRED
}

enum DurationKind {
  UNKNOWN
  TIMED
  MULTI_DAY
}

enum BayHoldPolicy {
  UNCONFIRMED
  CONTINUOUS
  SEGMENTED
}

enum SnapshotVersion {
  LEGACY_V1
  CATALOG_V2
  QUEUE_V3
}

// ADR-005 booking model (P1-02).
enum LinePriceStatus {
  PRICED
  FOR_QUOTE
}

enum LineWorkStatus {
  WAITING
  IN_PROGRESS
  DONE
}

enum BookingCancellationKind {
  CUSTOMER
  SHOP_DECLINED
  STAFF
}

enum BookingAuditAction {
  STATUS_CHANGED
  RESCHEDULED
  QUEUE_MOVED
  REORDERED
  LINE_ADDED
  LINE_REMOVED
  LINE_STATUS_CHANGED
  PRICE_SET
  BAY_ASSIGNED
  BAY_UNASSIGNED
  BAY_LIST_CHANGED
  WORKER_ASSIGNED
  WORKER_UNASSIGNED
  CAP_CHANGED
  CUSTOMER_NOTIFIED
  HISTORY_LOOKUP
  DEPOSIT_STATUS_CHANGED
  BOOKING_DELETED
}

// P1-18: the system records proof and status only; it never computes or moves money.
enum DepositStatus {
  NONE
  PROOF_SENT
  RECEIVED
  REJECTED
}

model CatalogRelease {
  id                 String                    @id @default(uuid())
  version            String                    @unique
  state              CatalogReleaseState       @default(DRAFT)
  sourcePath         String
  sourceReceivedDate DateTime                  @db.Date
  sourceSha256       String
  manifestSha256     String
  manifestJson       String
  reviewReference    String?
  publishedAt        DateTime?                 @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  services           CatalogServiceVersion[]
  head               CatalogHead?
  bookings           Booking[]
  events             CatalogPublicationEvent[] @relation("NewRelease")
  previousEvents     CatalogPublicationEvent[] @relation("PreviousRelease")

  @@map("catalog_releases")
}

model CatalogHead {
  shopId    Int            @id @default(1)
  releaseId String         @unique
  release   CatalogRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@map("catalog_head")
}

model CatalogServiceVersion {
  releaseId                  String
  serviceId                  String
  release                    CatalogRelease       @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  service                    Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  slug                       String
  name                       String
  sourceName                 String
  description                String?
  group                      CatalogServiceGroup
  type                       CatalogServiceType
  unit                       PriceUnit
  inclusions                 String[]
  productName                String?
  hardness                   String?
  warrantyMonths             Int?
  filmThicknessMil           String?
  referenceUnitPriceCentavos Int?
  sortOrder                  Int
  provenance                 Json
  queueCode                  String? // NULL only on releases published before the queue model
  queue                      BookingQueue?        @relation(fields: [queueCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  offers                     ServiceSizeOffer[]
  baseCompatibilities        AddOnCompatibility[] @relation("Base")
  addOnCompatibilities       AddOnCompatibility[] @relation("AddOn")

  @@id([releaseId, serviceId])
  @@unique([releaseId, slug])
  @@map("catalog_service_versions")
}

model ServiceSizeOffer {
  id                      String                @id
  releaseId               String
  serviceId               String
  vehicleCategoryId       String
  serviceVersion          CatalogServiceVersion @relation(fields: [releaseId, serviceId], references: [releaseId, serviceId], onDelete: Restrict)
  vehicleCategory         VehicleCategory       @relation(fields: [vehicleCategoryId], references: [id], onDelete: Restrict)
  sizeCode                String
  state                   OfferState
  bookingMode             CatalogBookingMode
  unitPriceCentavos       Int?
  compareAtCentavos       Int?
  sourceCompareAtCentavos Int?
  compareAtVerified       Boolean               @default(false)
  promoStartsAt           DateTime?             @db.Timestamptz(3)
  promoEndsAt             DateTime?             @db.Timestamptz(3)
  workPlan                ServiceWorkPlan?
  lines                   BookingLineItem[]

  @@unique([releaseId, serviceId, vehicleCategoryId])
  @@unique([id, releaseId, serviceId, vehicleCategoryId])
  @@map("service_size_offers")
}

model ServiceWorkPlan {
  offerId         String               @id
  offer           ServiceSizeOffer     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  kind            DurationKind
  durationMinutes Int?
  elapsedDays     Int?
  bayHoldPolicy   BayHoldPolicy        @default(UNCONFIRMED)
  segments        CatalogHoldSegment[]

  @@map("service_work_plans")
}

model CatalogHoldSegment {
  id        String          @id @default(uuid())
  offerId   String
  workPlan  ServiceWorkPlan @relation(fields: [offerId], references: [offerId], onDelete: Restrict)
  dayOffset Int
  startTime String
  endTime   String

  @@unique([offerId, dayOffset, startTime])
  @@map("catalog_hold_segments")
}

model AddOnCompatibility {
  releaseId      String
  baseServiceId  String
  addOnServiceId String
  base           CatalogServiceVersion @relation("Base", fields: [releaseId, baseServiceId], references: [releaseId, serviceId], onDelete: Restrict)
  addOn          CatalogServiceVersion @relation("AddOn", fields: [releaseId, addOnServiceId], references: [releaseId, serviceId], onDelete: Restrict)
  sizeCodes      String[]

  @@id([releaseId, baseServiceId, addOnServiceId])
  @@map("add_on_compatibility")
}

model BookingLineItem {
  id                         String              @id @default(uuid())
  bookingId                  String
  booking                    Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  order                      Int
  releaseId                  String
  serviceId                  String
  vehicleCategoryId          String
  offerId                    String
  offer                      ServiceSizeOffer    @relation(fields: [offerId, releaseId, serviceId, vehicleCategoryId], references: [id, releaseId, serviceId, vehicleCategoryId], onDelete: Restrict)
  type                       CatalogServiceType
  nameSnapshot               String
  unit                       PriceUnit
  quantity                   Int
  unitPriceCentavos          Int? // charged snapshot; NULL for a QUEUE_V3 FOR_QUOTE line
  subtotalCentavos           Int?
  addedMinutes               Int? // catalog-v2 only; durations are informational under ADR-005
  // ADR-005 / Amendment 1 (QUEUE_V3 lines). Snapshot columns above never change (A4).
  lineVersion                SnapshotVersion     @default(CATALOG_V2)
  priceStatus                LinePriceStatus?
  referenceUnitPriceCentavos Int?
  referenceSubtotalCentavos  Int?
  staffPriceCentavos         Int? // ADMIN-set final line price or override; the audit keeps the reason
  staffPriceSetAt            DateTime?           @db.Timestamptz(3)
  staffPriceSetByStaffId     String?
  staffPriceSetBy            Staff?              @relation("LinePriceSetBy", fields: [staffPriceSetByStaffId], references: [id], onDelete: Restrict)
  workStatus                 LineWorkStatus      @default(WAITING)
  workStatusChangedAt        DateTime?           @db.Timestamptz(3)
  addedAt                    DateTime            @default(now()) @db.Timestamptz(3)
  addedByStaffId             String? // NULL: created with the booking
  addedBy                    Staff?              @relation("LineAddedBy", fields: [addedByStaffId], references: [id], onDelete: Restrict)
  removedAt                  DateTime?           @db.Timestamptz(3)
  removedByStaffId           String?
  removedBy                  Staff?              @relation("LineRemovedBy", fields: [removedByStaffId], references: [id], onDelete: Restrict)

  @@unique([bookingId, order])
  @@map("booking_line_items")
}

// Only the migration owner provisions this mapping. Session DB identity supplies actor.
model CatalogPublisher {
  databaseRole String @id
  actorStaffId String
  actor        Staff  @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)

  @@map("catalog_publishers")
}

model CatalogPublicationEvent {
  id                     String          @id @default(uuid())
  releaseId              String
  previousReleaseId      String?
  release                CatalogRelease  @relation("NewRelease", fields: [releaseId], references: [id], onDelete: Restrict)
  previousRelease        CatalogRelease? @relation("PreviousRelease", fields: [previousReleaseId], references: [id], onDelete: Restrict)
  actorStaffId           String
  actor                  Staff           @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)
  databaseRole           String
  action                 String
  reason                 String
  reviewReference        String
  sourceSha256           String
  manifestSha256         String
  previousManifestSha256 String?
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)

  @@index([releaseId, createdAt])
  @@map("catalog_publication_events")
}

// -----------------------------------------------------------------------------
// ADR-005 queues, caps, bays and the staff audit trail (P1-02 booking model)
// -----------------------------------------------------------------------------

// Queue list (reference data). dailyCap NULL means unlimited; an explicit cap is enforced.
model BookingQueue {
  bayTypeMapping   BayTypeQueue?
  code             String                  @id
  name             String
  sortOrder        Int                     @unique
  isActive         Boolean                 @default(true)
  dailyCap         Int?
  revision         Int                     @default(1)
  updatedAt        DateTime                @db.Timestamptz(3)
  updatedByStaffId String?
  updatedBy        Staff?                  @relation("QueueUpdatedBy", fields: [updatedByStaffId], references: [id], onDelete: Restrict)
  capOverrides     QueueCapOverride[]
  bookings         Booking[]
  serviceVersions  CatalogServiceVersion[]
  auditEvents      BookingAuditEvent[]

  @@map("booking_queues")
}

model QueueCapOverride {
  id               String       @id @default(uuid())
  queueCode        String
  queue            BookingQueue @relation(fields: [queueCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  date             DateTime     @db.Date
  dailyCap         Int
  revision         Int          @default(1)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @db.Timestamptz(3)
  updatedByStaffId String
  updatedBy        Staff        @relation("CapOverrideUpdatedBy", fields: [updatedByStaffId], references: [id], onDelete: Restrict)

  @@unique([queueCode, date])
  @@map("queue_cap_overrides")
}

// Staff-side only; customers never see bays (ADR-005 §13). nameKey = lower(btrim(name)).
enum BayType {
  WASH
  DETAILING
  PAINT
}

model BayTypeQueue {
  queue     BookingQueue @relation(fields: [queueCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  queueCode String       @id
  bayType   BayType

  @@map("bay_type_queues")
}

model Bay {
  bayType     BayType
  occupancy   BayOccupancy?
  id          String                 @id @default(uuid())
  name        String
  nameKey     String                 @unique
  sortOrder   Int
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @db.Timestamptz(3)
  assignments BookingBayAssignment[]
  auditEvents BookingAuditEvent[]

  @@map("bays")
}

// Dated assignment history; BayOccupancy is the exclusive live physical location.
model BookingBayAssignment {
  bookingId         String
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  date              DateTime @db.Date
  bayId             String
  bay               Bay      @relation(fields: [bayId], references: [id], onDelete: Restrict)
  assignedAt        DateTime @db.Timestamptz(3)
  assignedByStaffId String
  assignedBy        Staff    @relation("BayAssignedBy", fields: [assignedByStaffId], references: [id], onDelete: Restrict)

  @@id([bookingId, date])
  @@index([bayId, date])
  @@map("booking_bay_assignments")
}

// Immutable staff audit trail (ADR-003 T-021, re-expressed for ADR-005). SELECT and INSERT only.
// HISTORY_LOOKUP stores a keyed HMAC-SHA256 digest of the normalized phone, never the phone.
model BayOccupancy {
  bookingId         String   @id
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bayId             String   @unique
  bay               Bay      @relation(fields: [bayId], references: [id], onDelete: Restrict)
  date              DateTime @db.Date
  assignedAt        DateTime @default(now()) @db.Timestamptz(3)
  assignedByStaffId String
  assignedBy        Staff    @relation("OccupancyAssignedBy", fields: [assignedByStaffId], references: [id], onDelete: Restrict)

  @@map("bay_occupancies")
}

model BookingWorkerAssignment {
  bookingId         String
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  staffId           String
  staff             Staff    @relation("AssignedWorker", fields: [staffId], references: [id], onDelete: Restrict)
  assignedAt        DateTime @default(now()) @db.Timestamptz(3)
  assignedByStaffId String
  assignedBy        Staff    @relation("WorkerAssignedBy", fields: [assignedByStaffId], references: [id], onDelete: Restrict)

  @@id([bookingId, staffId])
  @@map("booking_worker_assignments")
}

model BookingAuditEvent {
  targetStaffId         String?
  targetStaff           Staff?             @relation("WorkerAuditTarget", fields: [targetStaffId], references: [id], onDelete: Restrict)
  previousBayType       BayType?
  newBayType            BayType?
  id                    String             @id @default(uuid())
  action                BookingAuditAction
  actorStaffId          String
  actor                 Staff              @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)
  bookingId             String?
  lineId                String?
  queueCode             String?
  queue                 BookingQueue?      @relation(fields: [queueCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  bayId                 String?
  bay                   Bay?               @relation(fields: [bayId], references: [id], onDelete: Restrict)
  fromRevision          Int?
  toRevision            Int?
  fromStatus            BookingStatus?
  toStatus              BookingStatus?
  fromDate              DateTime?          @db.Date
  toDate                DateTime?          @db.Date
  fromQueueCode         String?
  toQueueCode           String?
  fromPosition          Int?
  toPosition            Int?
  fromLineStatus        LineWorkStatus?
  toLineStatus          LineWorkStatus?
  previousPriceCentavos Int?
  newPriceCentavos      Int?
  capDate               DateTime?          @db.Date
  previousCap           Int?
  newCap                Int?
  phoneDigest           String?
  resultCount           Int?
  fromDepositStatus     DepositStatus?
  toDepositStatus       DepositStatus?
  reason                String?
  bookingReference      String? // BOOKING_DELETED only: the reference code, never customer details
  requestId             String?
  txId                  BigInt             @default(dbgenerated("txid_current()"))
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)

  @@index([bookingId, createdAt])
  @@index([actorStaffId, createdAt])
  @@index([lineId])
  @@map("booking_audit_events")
}

model BookingOperation {
  id                String               @id @default(uuid())
  keyHash           String               @unique
  kind              String
  noChange          Boolean? // P1-04 immutable management no-op receipt; old/CREATE rows stay NULL
  bookingId         String?
  booking           Booking?             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  requestHash       String?
  outcome           String
  rejectionCode     String?
  rejectionData     Json?
  resultingRevision Int?
  credentialVersion Int?
  clientHash        String?
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  committedAt       DateTime?            @db.Timestamptz(3)
  recoveryExpiresAt DateTime             @db.Timestamptz(3)
  turnstileUse      BookingTurnstileUse?

  @@index([bookingId, createdAt])
  @@index([kind, outcome, createdAt])
  @@index([clientHash, kind, outcome, createdAt])
  @@map("booking_operations")
}

model BookingManagementGrant {
  id                String                     @id @default(uuid())
  bookingId         String
  booking           Booking                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  credentialVersion Int
  kid               String
  issuedAt          DateTime                   @db.Timestamptz(3)
  expiresAt         DateTime                   @db.Timestamptz(3)
  revokedAt         DateTime?                  @db.Timestamptz(3)
  sessions          BookingManagementSession[]

  @@index([bookingId, credentialVersion])
  @@map("booking_management_grants")
}

model BookingManagementSession {
  id                String                 @id @default(uuid())
  bookingId         String
  booking           Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  grantId           String
  grant             BookingManagementGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  credentialVersion Int
  kid               String
  grantKid          String
  issuedAt          DateTime               @db.Timestamptz(3)
  expiresAt         DateTime               @db.Timestamptz(3)
  revokedAt         DateTime?              @db.Timestamptz(3)

  @@index([bookingId, expiresAt])
  @@map("booking_management_sessions")
}

model BookingTurnstileUse {
  tokenHash   String           @id
  operationId String           @unique
  operation   BookingOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime         @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("booking_turnstile_uses")
}

model BookingNotificationOutbox {
  subject       String
  text          String
  id            String    @id @default(uuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  state         String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  sentAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([state, nextAttemptAt])
  @@map("booking_notification_outbox")
}

// P1-18 deposit proof: a sanitized image (metadata removed) stored in the database, never under
// a public path. No file name is kept. Rows are immutable apart from the shop-email delivery
// state; they go with their booking.
model BookingDepositProof {
  id                  String    @id @default(uuid())
  bookingId           String
  booking             Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  keyHash             String    @unique // sha256 of the customer's idempotency key
  contentHash         String // sha256 of the uploaded bytes (replay check)
  clientHash          String
  contentType         String // image/jpeg, image/png or image/webp, derived from the content
  byteSize            Int
  width               Int
  height              Int
  data                Bytes
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  createdTxId         BigInt    @default(dbgenerated("txid_current()"))
  notifyState         String    @default("PENDING")
  notifyAttempts      Int       @default(0)
  notifyNextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  notifySentAt        DateTime? @db.Timestamptz(3)

  @@index([bookingId, createdAt])
  @@index([notifyState, notifyNextAttemptAt])
  @@map("booking_deposit_proofs")
}
